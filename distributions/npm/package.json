  "type": "module",
  "description": "AJ Series & Aaahhh Fonts Vibe: 5 families (27 styles) CSS and OpenType ss06-ss18 helper",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Aravind Jayamohan, India",
  "homepage": "https://fonts.aivibe.cloud",
  "main": "./sound-of-font.js",
  "module": "./sound-of-font.js",
  "types": "./sound-of-font.d.ts",
  "files": [
    "LICENSE.md",
    "index.css",
    "3d-impressions.css",
    "sri-manifest.json",
